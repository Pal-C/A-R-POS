# Copy to .env and fill in values. Never commit .env.

# Database (matches docker-compose.yaml for local dev)
DB_NAME=ace_rally
DB_USER=ace_admin
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Auth / sessions
# Session lifetime in seconds, renewed on every request (default 8 hours).
DJANGO_SESSION_AGE=28800
# Set to True in production (HTTPS) so session and CSRF cookies are Secure.
DJANGO_SECURE_COOKIES=False
# Max login attempts per client IP, and per username (from any address).
DJANGO_LOGIN_THROTTLE_RATE=10/min
DJANGO_LOGIN_USERNAME_THROTTLE_RATE=10/min
# Login limits use Django's cache. The default local-memory cache is per process; with
# several server workers, configure a shared cache so the limits hold across them.

# Reverse proxy (production)
# Number of trusted proxies in front of Django (0 = none; X-Forwarded-For is ignored).
DJANGO_NUM_PROXIES=0
# True when the proxy terminates HTTPS and sets X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=False
# Comma-separated origins allowed to send POST/PATCH/DELETE, e.g. https://pos.example
DJANGO_CSRF_TRUSTED_ORIGINS=
