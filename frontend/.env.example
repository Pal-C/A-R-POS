# Copy to .env.local (or .env) to override. Never commit real env files.

# Base URL the browser uses for the API. Keep it a same-origin relative path so the
# session cookie and CSRF token work without CORS (see specs/004-frontend-foundation/research.md R4).
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_TARGET=http://localhost:8000

# Time zone used to display dates and times (storage stays UTC). Match the backend STORE_TIME_ZONE.
VITE_STORE_TIME_ZONE=Asia/Manila
